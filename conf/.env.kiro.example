# MySQL connection (used for storing parsed CSV data)
TEST_DEVOPS_DB_HOST='your-mysql-host.example.com'
TEST_DEVOPS_DB_NAME='your_database'
TEST_DEVOPS_DB_PORT='3306'
TEST_DEVOPS_DB_USER='your_db_user'
TEST_DEVOPS_DB_PASSWORD='your_db_password'

# Default AWS profile (must match a key in conf/accounts.json)
AWS_PROFILE='111111111111_AdministratorAccess'
AWS_REGION_DEFAULT='us-east-1'

# Data retention — local files older than this are deleted on each sync
DATA_RETENTION_DAYS=30

# ── Storage backend ──────────────────────────────────────────────────────────
# Which store to load ALL datasets into (user_report, by_user_analytic, prompt_log).
# One of: mysql | postgres | opensearch | elasticsearch | clickhouse
# Override per-run with --backend. Install the matching requirements-<backend>.txt.
# (MySQL is the default and needs the base requirements only.)
STORAGE_BACKEND=mysql

# PostgreSQL (--backend postgres)
PG_HOST='localhost'
PG_PORT='5432'
PG_DB='kiro'
PG_USER='postgres'
PG_PASSWORD='your_pg_password'

# OpenSearch / Elasticsearch (--backend opensearch | elasticsearch)
# One index per dataset: <prefix><dataset>, e.g. kiro-kiro_user_report, kiro-kiro_prompt_log
OPENSEARCH_HOST='https://localhost:9200'
OPENSEARCH_USER='admin'
OPENSEARCH_PASSWORD='your_opensearch_password'
OPENSEARCH_INDEX_PREFIX='kiro-'
OPENSEARCH_VERIFY_CERTS='false'

# ClickHouse (--backend clickhouse)
CLICKHOUSE_HOST='localhost'
CLICKHOUSE_PORT='8123'
CLICKHOUSE_DB='kiro'
CLICKHOUSE_USER='default'
CLICKHOUSE_PASSWORD=''
CLICKHOUSE_TABLE='kiro_prompt_log'
